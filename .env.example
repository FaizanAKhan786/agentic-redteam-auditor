# ── LLM Configuration ──────────────────────────────────────────────
# Point to any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenAI, etc.)
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_API_KEY=not-needed-for-local

# Model names — adjust to whatever your endpoint serves
TARGET_MODEL=llama3.1:8b
AUDITOR_MODEL=llama3.1:8b
JUDGE_MODEL=llama3.1:8b

# ── Optional: separate endpoint for the judge (reduces self-grading bias) ──
JUDGE_API_BASE=
JUDGE_API_KEY=

# ── Embedding model (runs locally via sentence-transformers) ──────
EMBEDDING_MODEL=all-MiniLM-L6-v2
